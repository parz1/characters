{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "workId": {
      "type": "string",
      "pattern": "^work_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "previousDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "record": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^work_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "enum": [
            "cn",
            "ja",
            "en"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "post",
            "log",
            "crap"
          ]
        },
        "attribution": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "human",
                "character",
                "dialogue"
              ]
            },
            "authors": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:person|character):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              }
            },
            "contributors": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:person|character):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              }
            }
          },
          "required": [
            "mode",
            "authors",
            "contributors"
          ],
          "additionalProperties": false
        },
        "stage": {
          "type": "string",
          "enum": [
            "discussion",
            "outline",
            "draft",
            "review",
            "ready"
          ]
        },
        "publication": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "published": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          "required": [
            "slug",
            "published"
          ],
          "additionalProperties": false
        },
        "contentRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "revision",
        "title",
        "language",
        "kind",
        "attribution",
        "stage",
        "contentRevision",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "properties": {
        "brief.md": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "outline.md": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "draft.md": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sources.json": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "brief.md",
        "outline.md",
        "draft.md",
        "sources.json"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "workId",
    "revision",
    "previousDigest",
    "record",
    "files"
  ],
  "additionalProperties": false,
  "title": "revision-manifest"
}
