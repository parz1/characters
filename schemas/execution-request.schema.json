{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^ses_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "work": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^work_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "messages": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "system",
                  "user",
                  "assistant"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "role",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "digest",
        "messages"
      ],
      "additionalProperties": false
    },
    "isolation": {
      "type": "string",
      "enum": [
        "strict",
        "relaxed"
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "const": "source.read"
          },
          "schemaVersion": {
            "type": "number",
            "const": 1
          }
        },
        "required": [
          "name",
          "schemaVersion"
        ],
        "additionalProperties": false
      }
    },
    "allowedSourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^src_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputUtf8Bytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "timeoutMs",
        "maxOutputUtf8Bytes",
        "maxToolCalls"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "runId",
    "sessionId",
    "input",
    "isolation",
    "tools",
    "allowedSourceIds",
    "limits"
  ],
  "additionalProperties": false,
  "title": "execution-request"
}
