{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "generation": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "pid": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "adminCredentialRef": {
      "type": "string",
      "pattern": "^\\.runtime\\/service\\/admin-[0-9a-f-]{36}\\.token$"
    }
  },
  "required": [
    "schemaVersion",
    "protocolVersion",
    "workspaceId",
    "generation",
    "pid",
    "host",
    "port",
    "adminCredentialRef"
  ],
  "additionalProperties": false,
  "title": "service-descriptor"
}
