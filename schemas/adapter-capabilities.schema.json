{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "adapterId": {
      "type": "string",
      "minLength": 1
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1
    },
    "hostVersion": {
      "type": "string",
      "minLength": 1
    },
    "freshExecution": {
      "type": "string",
      "enum": [
        "supported",
        "unsupported",
        "unknown"
      ]
    },
    "hostMemory": {
      "type": "string",
      "enum": [
        "disabled",
        "session-scoped",
        "global",
        "unknown"
      ]
    },
    "toolBoundary": {
      "type": "string",
      "enum": [
        "enforced",
        "none",
        "unknown"
      ]
    },
    "defaultConfigDiscovery": {
      "type": "string",
      "enum": [
        "controlled",
        "unknown"
      ]
    },
    "cancellation": {
      "type": "string",
      "enum": [
        "supported",
        "unsupported",
        "unknown"
      ]
    },
    "providerRetention": {
      "type": "string",
      "enum": [
        "configured",
        "unknown"
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^evd_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "validUntil": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "hostBinaryDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configurationDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "suiteVersion": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unverified"
          ]
        }
      },
      "required": [
        "id",
        "verifiedAt",
        "validUntil",
        "hostBinaryDigest",
        "configurationDigest",
        "suiteVersion",
        "result"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "adapterId",
    "adapterVersion",
    "hostVersion",
    "freshExecution",
    "hostMemory",
    "toolBoundary",
    "defaultConfigDiscovery",
    "cancellation",
    "providerRetention",
    "evidence"
  ],
  "additionalProperties": false,
  "title": "adapter-capabilities"
}
